{
  "name": "cashea-take-home-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Cashea take-home challenge — BNPL purchases-in-installments backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "start": "node dist/server.js",
    "migrate:up": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run tests/unit tests/frontend",
    "test:unit": "vitest run tests/unit",
    "pretest:integration": "node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs scripts/test-db.ts",
    "test:integration": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run tests/integration",
    "pretest:coverage": "node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs scripts/test-db.ts",
    "test:coverage": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run tests --coverage",
    "test:coverage:ci": "npm run test:coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7"
  }
}
